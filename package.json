{
  "name": "edukors-graph-editor",
  "productName": "Edukors Graph Editor",
  "private": true,
  "version": "26.11.5",
  "description": "Visual editor of Edukors Graph courses, built on Edukors Common.",
  "author": {
    "name": "Edukors",
    "url": "https://edukors.org"
  },
  "homepage": "https://github.com/mgarlabx/edukors_graph_editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/mgarlabx/edukors_graph_editor.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs --no-bump && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/build.mjs --no-bump && node scripts/package.mjs",
    "gen:types": "node scripts/gen-types.mjs",
    "gen:validators": "node scripts/gen-validators.mjs",
    "update-assets": "node scripts/update-assets.mjs"
  },
  "edukors": {
    "updates": "mgarlabx/edukors_graph_editor"
  },
  "dependencies": {
    "edukors-common-ux": "git+https://github.com/mgarlabx/edukors_common_ux.git#main"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dompurify": "^3.4.16",
    "electron": "44.10.0",
    "electron-builder": "26.17.0",
    "elkjs": "^0.12.0",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "^16.0.0",
    "marked": "^18.0.14",
    "monaco-editor": "^0.57.0",
    "playwright": "^1.63.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
