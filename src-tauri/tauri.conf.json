{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Edukors Graph Editor",
  "version": "2.0.0",
  "identifier": "org.edukors.grapheditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Edukors Graph Editor",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "shortDescription": "Editor visual de cursos Edukors Graph",
    "longDescription": "Editor visual para criar, validar, traduzir e testar cursos no padrão Edukors Graph.",
    "copyright": "Edukors — MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["egf"],
        "name": "Edukors Graph Course",
        "description": "Curso Edukors Graph",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/vnd.edukors.graph+json",
        "exportedType": {
          "identifier": "org.edukors.grapheditor.egf",
          "conformsTo": ["public.json"]
        }
      },
      {
        "ext": ["json"],
        "name": "Edukors Graph Course",
        "description": "Curso Edukors Graph",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": null
    }
  }
}
